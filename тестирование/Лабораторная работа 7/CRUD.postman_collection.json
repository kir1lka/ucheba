          }
        ],
        "url": "{{baseUrl}}/users",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Kirill\", \"email\": \"qa@example.test\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.test(\"Response value\",()=>pm.expect(pm.response.text()).to.include(\"Kirill\"));",
              "pm.collectionVariables.set('createdId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
