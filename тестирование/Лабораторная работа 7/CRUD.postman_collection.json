  "item": [
    {
      "name": "API-01 GET /users/1",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test(\"Response value\",()=>pm.expect(pm.response.text()).to.include(\"Initial User\"));"
            ]
          }
        }
      ]
    },
    {
